# Copier vers .env et remplir les valeurs (ne jamais commiter .env)
# Les secrets (SMTP, Gemini, JWT) ne doivent pas être versionnés.

# --- JWT / sessions applicatives (API Node utilise JWT ; pas Laravel session) ---
JWT_SECRET=changez_moi_minimum_32_caracteres
JWT_REFRESH_SECRET=autre_secret_refresh
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Durée de validité du code OTP (e-mail)
OTP_EXPIRES_MINUTES=15
# Durée du jeton retourné après validation OTP (soumission candidature)
OTP_PROOF_TTL_MINUTES=60

# Candidature stage : exiger OTP (false = désactivé pour tests locaux uniquement)
CANDIDATURE_OTP_REQUIRED=true

# Inscription interne (/register) : OTP e-mail (false = désactivé)
REGISTER_OTP_REQUIRED=true

# File e-mails Redis (optionnel). Sans REDIS_URL : file en mémoire dans le processus Node.
# REDIS_URL=redis://127.0.0.1:6379
# REDIS_EMAIL_QUEUE_KEY=cni:email_queue

# File d’attente e-mails (true = asynchrone, ne bloque pas la requête HTTP)
EMAIL_QUEUE=true

# --- SMTP (style Laravel MAIL_* ou ancien EMAIL_*) ---
USE_SMTP=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=cni_stages_formations

# Anciennes variables encore supportées :
# EMAIL_HOST, EMAIL_PORT, EMAIL_USER, EMAIL_PASSWORD, EMAIL_FROM

# --- IA (analyse CV : texte + PDF scannés via document Gemini) ---
# Clé : https://aistudio.google.com/apikey — redémarrer le backend après modification.
GEMINI_API_KEY=
# gemini-2.0-flash recommandé pour PDF multimodaux (Google AI Studio)
GEMINI_MODEL=gemini-2.0-flash

# --- Référence type Laravel (non utilisé tel quel par ce backend Node) ---
# SESSION_LIFETIME=120
# SESSION_DRIVER=file

# --- Base MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cni_stages_formations
DB_USER=root
DB_PASSWORD=

FRONTEND_URL=http://localhost:5173
